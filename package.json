{
  "name": "chatgpt-mcp",
  "version": "0.7.0",
  "description": "Cursor ↔ ChatGPT MCP handoff (portable taskId; Cursor E2E, other hosts experimental)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trankhanh040147/chatgpt-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gptmcp": "dist/gptmcp.js",
    "chatgpt-mcp": "dist/index.js",
    "handoff": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/start-broker-stack.sh",
    "scripts/supervise-status-api.sh",
    "scripts/start-chrome-cdp.mjs",
    "scripts/spawn-detached.mjs",
    "scripts/lib/macos-cdp-app.mjs",
    "docs/connect-chatgpt.md",
    "docs/workers.example.a1s.json"
  ],
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "npm run test:dashboard && npm run test:leases && npm run test:ops && npm run test:hook-ack && npm run test:usage && npm run test:create-worker && npm run test:agent-policy && npm run test:files && npm run test:rotation && npm run test:worker-ops && npm run test:chrome-cdp && npm run test:gptmcp-args",
    "test:dashboard": "tsx scripts/test-dashboard-pr1.ts",
    "test:gptmcp-args": "tsx scripts/test-gptmcp-args.ts",
    "check:unit": "npm run typecheck && npm run test:unit",
    "verify": "npm run check:unit && npm run build",
    "prepack": "npm run build",
    "package:check": "npm pack --dry-run",
    "package:smoke": "bash scripts/ci-package-smoke.sh",
    "build": "tsc && mkdir -p dist/db dist/dashboard dist/config && cp src/db/schema.sql dist/db/schema.sql && cp config/model-prices.json dist/config/model-prices.json && rm -rf dist/dashboard/public && cp -R src/dashboard/public dist/dashboard/public && node scripts/add-bin-shebang.mjs",
    "gptmcp": "node dist/gptmcp.js",
    "start": "tsx scripts/start.ts",
    "dev": "tsx src/index.ts",
    "mcp": "node dist/index.js mcp",
    "worker": "node dist/index.js worker",
    "remote-mcp": "node dist/index.js remote-mcp",
    "all": "node dist/index.js all",
    "typecheck": "tsc --noEmit",
    "e2e:create-chat": "tsx scripts/e2e-create-chat.ts",
    "e2e:reliability": "tsx scripts/e2e-create-chat.ts",
    "e2e:reliability:20": "tsx scripts/e2e-create-chat.ts -- --runs=20",
    "e2e:dual": "tsx scripts/e2e-dual-worker.ts",
    "diagnose:plus-menu": "tsx scripts/diagnose-plus-menu.ts",
    "setup": "tsx scripts/setup.ts",
    "install:project": "bash scripts/install.sh",
    "test:install-smoke": "bash scripts/test-install-smoke.sh",
    "check": "tsx scripts/check.ts",
    "recover": "tsx scripts/recover.ts",
    "clear-tasks": "tsx scripts/recover.ts --purge",
    "doctor": "tsx scripts/doctor.ts",
    "test:leases": "tsx scripts/test-leases.ts",
    "test:ops": "tsx scripts/test-ops-recover.ts",
    "test:hook-ack": "tsx scripts/test-hook-followup-ack.ts",
    "test:usage": "tsx scripts/test-usage.ts",
    "usage:backfill": "tsx scripts/usage-backfill.ts",
    "spike:a1s": "tsx scripts/spike-a1s.ts",
    "spike:a1s:live": "tsx scripts/spike-a1s.ts --live",
    "rotate-worker": "tsx scripts/rotate-worker.ts",
    "test:create-worker": "tsx scripts/test-create-worker-registry.ts",
    "test:agent-policy": "tsx scripts/test-agent-policy.ts",
    "test:files": "tsx scripts/test-files.ts",
    "test:attachment-match": "tsx scripts/test-attachment-match.ts",
    "e2e:files-attach": "tsx scripts/e2e-files-attach.ts",
    "test:rotation": "tsx scripts/test-rotation.ts",
    "test:worker-ops": "tsx scripts/test-worker-ops.ts",
    "test:chrome-cdp": "node scripts/test-chrome-cdp.mjs",
    "status-api": "node dist/index.js status-api",
    "browser-worker": "node dist/index.js browser-worker",
    "browser-broker": "node dist/index.js browser-broker",
    "chrome-cdp": "node scripts/start-chrome-cdp.mjs",
    "chrome:cdp": "node scripts/start-chrome-cdp.mjs"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^17.4.2",
    "js-tiktoken": "^1.0.21",
    "playwright": "^1.62.1",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}
