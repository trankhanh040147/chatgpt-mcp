{
  "name": "chatgpt-mcp",
  "version": "0.5.0",
  "description": "Cursor ↔ ChatGPT MCP handoff (portable taskId; Cursor E2E, other hosts experimental)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trankhanh040147/chatgpt-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chatgpt-mcp": "dist/index.js",
    "handoff": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/db dist/dashboard dist/config && cp src/db/schema.sql dist/db/schema.sql && cp config/model-prices.json dist/config/model-prices.json && rm -rf dist/dashboard/public && cp -R src/dashboard/public dist/dashboard/public",
    "start": "tsx scripts/start.ts",
    "dev": "tsx src/index.ts",
    "mcp": "node dist/index.js mcp",
    "worker": "node dist/index.js worker",
    "remote-mcp": "node dist/index.js remote-mcp",
    "all": "node dist/index.js all",
    "typecheck": "tsc --noEmit",
    "e2e:reliability": "tsx scripts/e2e-reliability.ts",
    "e2e:reliability:20": "tsx scripts/e2e-reliability.ts --runs=20",
    "e2e:dual": "tsx scripts/e2e-dual-worker.ts",
    "setup": "tsx scripts/setup.ts",
    "check": "tsx scripts/check.ts",
    "recover": "tsx scripts/recover.ts",
    "clear-tasks": "tsx scripts/recover.ts --purge",
    "doctor": "tsx scripts/doctor.ts",
    "test:leases": "tsx scripts/test-leases.ts",
    "test:ops": "tsx scripts/test-ops-recover.ts",
    "test:usage": "tsx scripts/test-usage.ts",
    "usage:backfill": "tsx scripts/usage-backfill.ts",
    "spike:a1s": "tsx scripts/spike-a1s.ts",
    "spike:a1s:live": "tsx scripts/spike-a1s.ts --live",
    "rotate-worker": "tsx scripts/rotate-worker.ts",
    "test:create-worker": "tsx scripts/test-create-worker-registry.ts",
    "test:agent-policy": "tsx scripts/test-agent-policy.ts",
    "test:rotation": "tsx scripts/test-rotation.ts",
    "status-api": "node dist/index.js status-api",
    "browser-worker": "node dist/index.js browser-worker",
    "browser-broker": "node dist/index.js browser-broker",
    "chrome-cdp": "node scripts/start-chrome-cdp.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.4.7",
    "js-tiktoken": "^1.0.21",
    "playwright": "^1.62.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
