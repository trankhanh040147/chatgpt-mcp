# Database
HANDOFF_DB_PATH=./data/handoff.sqlite

# HTTP status API (used by Cursor stop hook)
HANDOFF_HTTP_PORT=8787

# Browser worker
CHATGPT_WORKER_CONVERSATION=Cursor Handoff Worker
CHATGPT_PROFILE_PATH=./data/chatgpt-profile
CHATGPT_URL=https://chatgpt.com
# "chrome" uses your real installed Chrome binary (still via its own isolated
# profile at CHATGPT_PROFILE_PATH) instead of Playwright's bundled "Chrome for
# Testing" build, which some bot-detection services flag more aggressively.
# Leave unset to use the bundled Chromium.
CHATGPT_BROWSER_CHANNEL=chrome

# Polling intervals (seconds)
DISPATCH_POLL_INTERVAL_MS=2000
DISPATCH_APPROVAL_TIMEOUT_MS=300000
RATE_LIMIT_BACKOFF_MS=300000,900000,1800000

# Cursor stop hook (seconds)
HANDOFF_WAIT_TIMEOUT=480
HANDOFF_POLL_INTERVAL=2

# Logging
LOG_DIR=./logs

# Remote MCP (ChatGPT connector, exposed via a tunnel e.g. ngrok)
HANDOFF_REMOTE_MCP_PORT=8790
# Leave unset to auto-generate on first `npm run remote-mcp` (written back to .env)
HANDOFF_REMOTE_MCP_TOKEN=
