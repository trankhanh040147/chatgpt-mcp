# Per-user data root (DB + logs). Defaults to ~/.chatgpt-mcp when unset.
# CHATGPT_MCP_HOME=~/.chatgpt-mcp

# Database — absolute path recommended for user-level Cursor MCP (Node does not expand ~).
# Default if unset: $CHATGPT_MCP_HOME/data/handoff.sqlite
# HANDOFF_DB_PATH=

# HTTP status API (used by Cursor stop hook) — loopback only
HANDOFF_HTTP_PORT=8787

# Multi-worker (0.2.0): stable worker id (default: "default")
# HANDOFF_WORKER_ID=w1
# Lease TTL (ms). Must outlast Playwright nudge (~30s) and stay above poll×10.
# Default ~ max(120000, poll*10, min(approvalTimeout, 300000)).
# HANDOFF_LEASE_MS=180000
# HANDOFF_WORKER_STALE_MS=360000
# Lease must be ≥90s and leave margin for Playwright ops (≤60s) + renewals (~lease/6).
# HANDOFF_REAPER_INTERVAL_MS=2000
# Worker chat rotation (0.5): max TASK_ID dispatches per chat before rotate
# HANDOFF_MAX_TASKS_PER_CHAT=20
# Database — absolute path recommended for user-level Cursor MCP (Node does not expand ~).
# Default if unset: $CHATGPT_MCP_HOME/data/handoff.sqlite
# HANDOFF_DB_PATH=

# Worker topology: SQLite worker_state (default). Legacy JSON only if set:
# HANDOFF_WORKERS_SOURCE=file
# HANDOFF_WORKERS_FILE=~/.chatgpt-mcp/data/workers.json

# Dashboard 0.2: off | redacted — on-demand task prompt/result previews (never on list poll)
# HANDOFF_DASHBOARD_TASK_CONTENT=off

# Estimated visible-text tokens are always tracked. Optional REFERENCE cost
# comparison (Cursor/API list rates) is OFF by default — not ChatGPT billing.
# HANDOFF_REFERENCE_PRICING=off
# HANDOFF_REFERENCE_PRICING=on
# HANDOFF_REFERENCE_SCENARIO=claude-sonnet-5
# HANDOFF_COST_MODEL=claude-sonnet-5
# HANDOFF_COST_PRICE_TABLE=./config/model-prices.json
# HANDOFF_COST_CONTEXT_MULTIPLIER=1
# HANDOFF_TOKEN_UNCERTAINTY_PCT=30
# Each worker needs its own Chrome profile + CDP endpoint + chat URL.
# Modes: status-api (HTTP+reaper on :8787), browser-worker (CDP only),
#         worker/all (status-api + one browser in-process, single-worker default).

# Browser worker — attach via CDP to a Chrome that already has remote debugging.
# Chrome 136+ IGNORES --remote-debugging-port on the default user-data-dir
# (https://developer.chrome.com/blog/remote-debugging-port). You MUST use a
# non-standard dir (./scripts/start-chrome-cdp.sh → $CHATGPT_MCP_HOME/chrome-profile)
# On macOS the launcher also prepares $CHATGPT_MCP_HOME/Chrome CDP.app (distinct Dock icon + bundle id).
# Override with CHATGPT_CDP_USER_DATA_DIR or CHROME_BIN / CHATGPT_MCP_CHROME_PATH.
# and sign into ChatGPT in THAT window. Do not copy Default cookies.
#
# 1. ./scripts/start-chrome-cdp.sh
# 2. Log into ChatGPT in the CDP window; copy worker chat URL here.
# 3. npm run worker
# Do NOT use launchPersistentContext / password automation.
CHATGPT_CDP_ENDPOINT=http://127.0.0.1:9222
CHATGPT_WORKER_URL=https://chatgpt.com/c/REPLACE_WITH_WORKER_CHAT_ID
CHATGPT_URL=https://chatgpt.com

# Polling intervals (ms)
DISPATCH_POLL_INTERVAL_MS=2000
DISPATCH_APPROVAL_TIMEOUT_MS=120000
# Hard cap while ChatGPT is still generating (default max(3×approval, 15m)).
# DISPATCH_HARD_TIMEOUT_MS=900000
RATE_LIMIT_BACKOFF_MS=300000,900000,1800000

# Cursor stop hook (seconds) — prefers GET /tasks/:id/wait long-poll
# Keep ≥ DISPATCH_HARD_TIMEOUT_MS so late submit after TIMED_OUT still resumes Cursor.
HANDOFF_WAIT_TIMEOUT=960
HANDOFF_POLL_INTERVAL=0.5
# Server-side long-poll tick (ms) for GET /tasks/:id/wait
HANDOFF_WAIT_TICK_MS=250

# Logging — default if unset: $CHATGPT_MCP_HOME/logs
# LOG_DIR=

# Remote MCP (ChatGPT connector, exposed via a tunnel e.g. ngrok)
HANDOFF_REMOTE_MCP_PORT=8790
# Leave unset to auto-generate on first `npm run remote-mcp` (written back to .env)
HANDOFF_REMOTE_MCP_TOKEN=

# Browser broker control plane (0.6) — loopback HTTP for tab bind / probe / create-chat.
# Must be identical for browser-broker and status-api (start-broker-stack.sh persists to logs/broker-ops.token).
# HANDOFF_BROKER_OPS_PORT=18788
# HANDOFF_BROKER_OPS_TOKEN=

# Worker ops reconcile interval (ms) — status-api polls worker_operations journal
# HANDOFF_RECONCILE_INTERVAL_MS=5000
# SYSTEM_PROBE attempts after URL assign / create-chat
# HANDOFF_WORKER_OPS_PROBE_ATTEMPTS=12

# NOTE: Full MCP write tools (handoff_submit_result) require a ChatGPT plan that
# supports Developer Mode + MCP write. Workspace policy can still disable tools.
# Prefer Secure MCP Tunnel for private tasks; public tunnels are evaluation-only.
