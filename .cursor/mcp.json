{
  "mcpServers": {
    "chatgpt-mcp": {
      "command": "node",
      "args": ["${workspaceFolder}/dist/index.js", "mcp"],
      "env": {
        "HANDOFF_DB_PATH": "${workspaceFolder}/data/handoff.sqlite",
        "LOG_DIR": "${workspaceFolder}/logs"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ]
    }
  }
}
